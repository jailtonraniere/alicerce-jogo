# Copie para .env.local e preencha. Sem estas variaveis, o jogo roda com
# ranking local (localStorage) e nao grava leads. Com elas, usa o Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Identifica o evento no ranking e nos leads (ex.: congemas-2026, feira-govtech).
VITE_EVENTO=demonstracao
